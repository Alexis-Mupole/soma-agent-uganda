# Soma-Agent environment
#
# Every variable is optional. With none of them set, the app runs in demo mode
# using the bundled dataset and the offline curriculum tutor.

# Supabase (optional) - enables live data and hosted authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (optional) - enables model-generated tutoring and quizzes.
# Requests fall back to the offline curriculum engine when this is empty.
GEMINI_API_KEY=

# Public canonical URL (optional).
NEXT_PUBLIC_APP_URL=http://localhost:3000
